# GFIT-CoWork -- the config file for one Deployment (one Team).
#
# Copy to .env next to docker-compose.yml and fill in every value. Keep .env
# readable by root only (chmod 600): it holds the API keys.

# ── The Deployment ─────────────────────────────────────────────────────────
# Short Team name, lowercase. Names the containers and volumes (gfit-sales-...).
TEAM=sales
# The host port GFIT-CoWork listens on (loopback only). One per Deployment;
# the reverse proxy points this Team's hostname at it.
GFIT_PORT=8801
# The hostname people open, without https://. Must match the Caddyfile.
GFIT_HOSTNAME=sales.cowork.gfit.co.th

# ── The Directory: company AD over LDAPS ───────────────────────────────────
HERMES_WEBUI_DIRECTORY=ldap
# ldaps:// (port 636). For ldap:// set HERMES_WEBUI_LDAP_STARTTLS=1; plain
# LDAP is refused.
HERMES_WEBUI_LDAP_URL=ldaps://ad.gfit.co.th
# upn -> 521740@<domain>; domain -> <DOMAIN>\521740
HERMES_WEBUI_LDAP_BIND_FORMAT=upn
HERMES_WEBUI_LDAP_DOMAIN=gfit.co.th
# Where to find users to read their displayName.
HERMES_WEBUI_LDAP_BASE_DN=DC=gfit,DC=co,DC=th
# The AD CA certificate: put the file in ./certs next to docker-compose.yml.
HERMES_WEBUI_LDAP_CA_CERT=/certs/ad-ca.crt

# ── API keys (one set per Deployment) ──────────────────────────────────────
# The model provider key for this Team. Use the variable your provider needs
# (e.g. OPENROUTER_API_KEY, ANTHROPIC_API_KEY, OPENAI_API_KEY). It serves Hermes
# Agent's gateway. Users' Profiles do not inherit keys from here: the Operator
# also saves the key in the `default` Profile (`hermes model`), and each new
# Profile copies it with `operator_cli create ... --clone-from default`
# (deploy/README.md). There is no Admin list: Profiles are managed on the server.
OPENROUTER_API_KEY=replace-with-this-teams-provider-key
# The key between GFIT-CoWork and Hermes Agent's gateway. Any random string of
# 16+ characters, different for each Deployment: openssl rand -hex 24
API_SERVER_KEY=replace-with-openssl-rand-hex-24

# ── Optional ───────────────────────────────────────────────────────────────
# Images. Build GFIT-CoWork once per server: docker build -t gfit-cowork:latest <repo>
GFIT_COWORK_IMAGE=gfit-cowork:latest
# Pinned: Hermes Agent v0.21.6 (latest since 2026-10-08) installs its base
# dependencies only on Python 3.14+, and GFIT-CoWork runs Python 3.12. Upgrade
# the two images together (docs/docker.md).
HERMES_AGENT_IMAGE=nousresearch/hermes-agent:v2026.9.24
# The owner of files in the volumes (id -u / id -g of the server's service user).
UID=1000
GID=1000
# Where the reverse proxy connects from; the Docker bridge networks by default.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
